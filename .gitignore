# This repository is PUBLIC. Anything below could hold a secret, an AWS account id or a path on one person's laptop:
# keep it out of git. (If a name here is already committed, `git rm --cached <file>` first: .gitignore only stops NEW files.)

# ---- secrets: AWS uses OIDC in this project, so there is no key to commit. A local .env (LLM keys) must never be.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials
.aws/
*.secret
secrets.*

# ---- Terraform: state holds resource ids and sometimes values; plans hold everything; backend.hcl names YOUR bucket
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
.terraform.tfstate.lock.info
backend.hcl
crash.log
crash.*.log
# personal values (account ids, owner). deploy/terraform/envs/*.tfvars are the shared ones and ARE committed.
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
# NOT ignored on purpose: .terraform.lock.hcl (it pins the provider version everybody uses)

# ---- generated by the data pipeline and the image build: never committed (the baked fallback is made inside the build)
# (anchored with a leading "/": src/financial_risk/data/ and src/financial_risk/models/ are CODE)
/data/
/models/
/vector_index/
/vector_index_*/
/experiment_log.csv
/reports/*
!/reports/.gitkeep
/build/

# ---- Python and tools
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ---- editor / OS litter
.DS_Store
.idea/
.vscode/
