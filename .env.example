APP_ENV=dev
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=deepseek.v3.2
BEDROCK_MAX_TOKENS=600
BEDROCK_TEMPERATURE=0.2
LOG_LEVEL=INFO

# ---------------------------------------------------------------- LLM provider (week 10)
# none     = deterministic local template. The whole course runs on this, offline and free.
# deepseek = DeepSeek cloud API (create a key on the DeepSeek developer platform).
# bedrock  = AWS Bedrock Converse API (no key: the Lambda/ECS role is the credential; locally `aws login`).
LLM_PROVIDER=none

# Paste your key between the = and the end of the line. Leave EMPTY to stay on the template.
# Never commit a real key: .env is gitignored, .env.example is not.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Current model ids: deepseek-flash (cheap, use this) or deepseek-v4-pro.
# NOTE: the deepseek-chat / deepseek-reasoner names in older tutorials are retired and error.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=600
DEEPSEEK_TEMPERATURE=0.2

# ---------------------------------------------------------------- API service (week 10)
API_HOST=127.0.0.1
API_PORT=8000

DATASET_URL=https://huggingface.co/datasets/kohdified/synthetic-financial-data/resolve/main/paysim.csv
RAW_DATA_PATH=data/raw/paysim.csv
# demo = 5k-row sample, fast local iteration. full = real ~494MB / 6.3M-row PaySim via DuckDB.
DATA_MODE=demo

# ---------------------------------------------------------------- Model and knowledge index (13b)
# Empty = the baked demo model and index (a laptop, the tests). In AWS, Terraform (deploy/terraform) sets
# POINTER_PREFIX=/finrisk/<env>: the service then reads <prefix>/model and <prefix>/index from SSM Parameter
# Store, downloads what they name, and looks again every POINTER_TTL_SECONDS. finrisk-ml and finrisk-knowledge
# write those two parameters; this service only reads them.
POINTER_PREFIX=
POINTER_TTL_SECONDS=60
# POINTER_REFRESH=background   # inline on Lambda (the default there), background elsewhere
# INLINE_LOAD_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------- AWS (13b)
# Running locally you need only: APP_ENV, LLM_PROVIDER (none | deepseek | bedrock), DEEPSEEK_API_KEY
# (blank, local only), BEDROCK_MODEL_ID and AWS_REGION -- all set at the top of this file.
# In AWS none of this file is used: Terraform (deploy/terraform) sets APP_ENV, LLM_PROVIDER=bedrock,
# BEDROCK_MODEL_ID, APP_IMAGE_DIGEST, POINTER_PREFIX and POINTER_TTL_SECONDS on the function / service, and there
# is NO key -- the app's IAM role is the credential. Deploys are GitHub Actions workflows (docs/runbook.md).
