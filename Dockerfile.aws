# The RELEASE image = the service image + a small baked fallback + the Lambda Web Adapter.
#
# scripts/build_release.sh builds the service image from the root Dockerfile first, then builds THIS file on top:
#   docker buildx build --platform linux/amd64 --provenance=false --load -t finrisk-service:dev .
#   docker buildx build --platform linux/amd64 --provenance=false --load \
#     --build-arg SERVICE_IMAGE=finrisk-service:dev -t finrisk-app:dev -f Dockerfile.aws .
#
# THE BAKED FALLBACK. The service normally serves the model and the knowledge index that two SSM pointers
# name (finrisk-ml and finrisk-knowledge own them). A pointer that is still null -- the very first deploy,
# a laptop, a test -- means "use the baked ones": a demo model trained on 5,000 synthetic transactions and
# a small TF-IDF index of rag_docs/. They are made by the RUN line below, INSIDE the build, so they are
# produced by the exact library versions the image ships (a model pickled on a laptop and loaded by other
# versions is a classic way to get a service that starts and cannot answer). Nothing binary lives in git.
#
# The adapter is a Lambda *extension*: Lambda starts it, it turns each Lambda event into a normal HTTP request
# to uvicorn on $PORT (8000), and hands the response back. Anywhere else -- your laptop, ECS Express Mode --
# nothing starts it, so the SAME image runs on both computes and the artifact that passed dev is byte-identical
# to the one that reaches prod. Only environment variables (APP_ENV, POINTER_PREFIX ...) differ between environments.
ARG SERVICE_IMAGE=finrisk-service:dev
FROM ${SERVICE_IMAGE}

RUN DATA_MODE=demo LLM_PROVIDER=none python scripts/run_pipeline.py --demo-rows 5000 && rm -rf data/raw data/bronze data/silver data/gold/customer_features.parquet reports experiment_log.csv

COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0 /lambda-adapter /opt/extensions/lambda-adapter
